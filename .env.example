# ===== 模型 (OpenAI 兼容网关, 如 LiteLLM) =====
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://<your-gateway>:4000/v1
LLM_API_KEY=sk-xxxx                 # 生产建议改用 LLM_API_KEY_SECRET_ID (Secrets Manager)
LLM_MODEL=kimi-k3

# ===== Embedding (Mem0 向量化) =====
EMBED_PROVIDER=openai_compatible
EMBED_BASE_URL=http://<your-gateway>:4000/v1
EMBED_API_KEY=sk-xxxx
EMBED_MODEL=titan-embed-v2
EMBED_DIMS=1024

# ===== 长期记忆: Aurora PostgreSQL + pgvector =====
PG_HOST=<aurora-endpoint>
PG_PORT=5432
PG_DBNAME=mem0
PG_USER=postgres
PG_PASSWORD=<alnum-only>            # 或 PG_PASSWORD_SECRET_ID=<secret arn> + PG_PASSWORD_SECRET_KEY=password

# ===== 短期记忆: S3 会话持久化 (不配则用本地文件) =====
SESSION_S3_BUCKET=<bucket>

# ===== 评估 =====
AWS_REGION=cn-northwest-1
JUDGE_PROVIDER=openai_compatible
JUDGE_BASE_URL=http://<your-gateway>:4000/v1
JUDGE_API_KEY=sk-xxxx
JUDGE_MODEL=kimi-k3
JUDGE_MAX_TOKENS=4096               # kimi 类推理模型需要较大的输出预算
RUNTIME_ID=<agent-runtime-id>       # 例如 memory_agent_ab12cd-XXXXXXXXXX
EVAL_RESULTS_BUCKET=<bucket>        # 可选, 不配则写本地 eval_output/
LLM_SUPPORTS_TEMPERATURE=false     # kimi-k3 拒绝 temperature 参数
JUDGE_SUPPORTS_TEMPERATURE=false
